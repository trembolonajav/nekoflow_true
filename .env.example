# Copie para .env e ajuste se precisar (o docker-compose lê automaticamente).
DB_NAME=nekoflow
DB_USER=nekoflow
DB_PASSWORD=nekoflow
DB_PORT=9432
BACKEND_PORT=9090
FRONTEND_PORT=9080
NEKOFLOW_PUBLIC_URL=http://localhost:9080
MAILPIT_SMTP_PORT=9026
MAILPIT_UI_PORT=9025
SESSION_COOKIE_SECURE=false

# O worker consulta os endpoints públicos do HiAnime a cada 15 minutos.
HIANIME_SYNC_ENABLED=true
HIANIME_SYNC_INTERVAL_MS=900000
HIANIME_SYNC_INITIAL_DELAY_MS=90000
HIANIME_SYNC_RECENT_PAGES=2
HIANIME_API_TIMEOUT_SECONDS=20
HIANIME_ORIGIN=https://hianime.at

# Adaptador não oficial, somente leitura, para o catálogo público do MangaLivre.
MANGALIVRE_ENABLED=true
MANGALIVRE_ORIGIN=https://mangalivre.blog
MANGALIVRE_API_TIMEOUT_SECONDS=20
MANGALIVRE_CACHE_TTL_SECONDS=120

# Adaptador não oficial somente leitura. Catálogo e capítulos exclusivamente em inglês.
WEEBCENTRAL_EN_ENABLED=true
WEEBCENTRAL_EN_ORIGIN=https://weebcentral.com
WEEBCENTRAL_EN_API_TIMEOUT_SECONDS=20
WEEBCENTRAL_EN_CACHE_TTL_SECONDS=120

# APIs normalizadas de leitura: TiaManhwa (PT-BR), Comix (EN) e ManhwaBuddy (EN).
READING_PROVIDERS_TIMEOUT_SECONDS=20
READING_PROVIDERS_CACHE_TTL_SECONDS=120
TIAMANHWA_ORIGIN=https://tiamanhwa.com
COMIX_ORIGIN=https://comix.to
MANHWABUDDY_ORIGIN=https://manhwabuddy.com
TIAMANHWA_FETCHER_URL=http://tia-fetcher:8090
TIA_HOST_ADAPTER_URL=http://host.docker.internal:19091
COMIX_FETCHER_URL=http://comix-fetcher:8091
COMIX_FETCHER_SECRET=dev-only-comix-fetcher-secret
TIA_FETCHER_SECRET=troque-este-segredo-em-producao

# Contas de demonstração (marina, kenji e admin) criadas na primeira subida.
# Em produção: NEKOFLOW_DEMO=false.
NEKOFLOW_DEMO=true
NEKOFLOW_DEMO_PASSWORD=123456

# Produção: configure SMTP real, HTTPS e cookie Secure no serviço backend.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# SESSION_COOKIE_SECURE=true

# Provisionamento explícito do primeiro admin (ligue somente na primeira subida e desligue depois).
NEKOFLOW_BOOTSTRAP_ADMIN=false
NEKOFLOW_BOOTSTRAP_ADMIN_USERNAME=
NEKOFLOW_BOOTSTRAP_ADMIN_EMAIL=
NEKOFLOW_BOOTSTRAP_ADMIN_PASSWORD=

