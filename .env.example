# Copie para .env e ajuste se precisar (o docker-compose lê automaticamente).
DB_NAME=nekoflow
DB_USER=nekoflow
DB_PASSWORD=nekoflow
DB_PORT=9432
BACKEND_PORT=9090
FRONTEND_PORT=9080
NEKOFLOW_PUBLIC_URL=http://localhost:9080
MAILPIT_SMTP_PORT=9026
MAILPIT_UI_PORT=9025
SESSION_COOKIE_SECURE=false

# Contas de demonstração (marina, kenji e admin) criadas na primeira subida.
# Em produção: NEKOFLOW_DEMO=false.
NEKOFLOW_DEMO=true
NEKOFLOW_DEMO_PASSWORD=nekoflow2026

# Produção: configure SMTP real, HTTPS e cookie Secure no serviço backend.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# SESSION_COOKIE_SECURE=true

# Provisionamento explícito do primeiro admin (ligue somente na primeira subida e desligue depois).
NEKOFLOW_BOOTSTRAP_ADMIN=false
NEKOFLOW_BOOTSTRAP_ADMIN_USERNAME=
NEKOFLOW_BOOTSTRAP_ADMIN_EMAIL=
NEKOFLOW_BOOTSTRAP_ADMIN_PASSWORD=

